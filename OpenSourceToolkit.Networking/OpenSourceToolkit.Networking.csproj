<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenSourceToolkit.Core\OpenSourceToolkit.Core.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Scheduling\OpenSourceToolkit.Scheduling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath Condition="'$(Configuration)'=='Debug'">..\bin\debug\</OutputPath>

    <Authors>OpenSourceToolkit Contributors</Authors>
    <Company>OpenSourceToolkit</Company>
    <Product>OpenSourceToolkit.Net</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile Condition="'$(Configuration)'=='Release'">true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>

  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>

</Project>
