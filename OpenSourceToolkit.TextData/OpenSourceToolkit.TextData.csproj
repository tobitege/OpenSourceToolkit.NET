<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenSourceToolkit.Core\OpenSourceToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath Condition="'$(Configuration)'=='Debug'">..\bin\debug\</OutputPath>

    <Authors>OpenSourceToolkit Contributors</Authors>
    <Company>OpenSourceToolkit</Company>
    <Product>OpenSourceToolkit.Net</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile Condition="'$(Configuration)'=='Release'">true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
