<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:controls="using:OpenSourceToolkit.NET.Controls"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             x:Class="OpenSourceToolkit.NET.Views.Tools.HmacToolView"
             x:DataType="vm:HmacToolViewModel">
    <StackPanel Spacing="10">
        <TextBlock Text="{loc:Localize Hmac_Message_Label}" />
        <daisy:DaisyInput Text="{Binding Input}" PlaceholderText="{loc:Localize Hmac_Message_Watermark}" />

        <TextBlock Text="{loc:Localize Hmac_Key_Label}" />
        <daisy:DaisyInput Text="{Binding Key}" PlaceholderText="{loc:Localize Hmac_Key_Watermark}" PasswordChar="*" />

        <daisy:DaisyButton Command="{Binding GenerateCommand}" Content="{loc:Localize Hmac_Generate_Button}" Variant="Primary" HorizontalAlignment="Left" />

        <TextBlock Text="{loc:Localize Hmac_Sha256_Label}" FontWeight="SemiBold"/>
        <controls:CopyableInput Text="{Binding OutputSha256}" IsReadOnly="True"/>

        <TextBlock Text="{loc:Localize Hmac_Sha512_Label}" FontWeight="SemiBold"/>
        <controls:CopyableInput Text="{Binding OutputSha512}" IsReadOnly="True"/>
    </StackPanel>
</UserControl>
