<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:controls="using:OpenSourceToolkit.NET.Controls"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             x:Class="OpenSourceToolkit.NET.Views.Tools.IpLocationToolView"
             x:DataType="vm:IpLocationToolViewModel">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <daisy:DaisyInput Text="{Binding IpAddress}" PlaceholderText="{loc:Localize IpLocation_IpAddress_Watermark}" Width="300" />
            <daisy:DaisyButton Command="{Binding LookupCommand}" Content="{loc:Localize Button_Locate}" Variant="Primary" />
        </StackPanel>

        <controls:CopyableTextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200"/>
    </StackPanel>
</UserControl>
