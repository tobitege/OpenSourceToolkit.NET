<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:controls="using:OpenSourceToolkit.NET.Controls"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             x:Class="OpenSourceToolkit.NET.Views.Tools.DnsToolView"
             x:DataType="vm:DnsToolViewModel">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <daisy:DaisyInput Text="{Binding Domain}" PlaceholderText="{loc:Localize Dns_Domain_Watermark}" Width="300" />
            <daisy:DaisyButton Command="{Binding LookupCommand}" Content="{loc:Localize Dns_Lookup_Button}" Variant="Primary" />
        </StackPanel>

        <controls:CopyableTextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="300"/>
    </StackPanel>
</UserControl>
