<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             x:Class="OpenSourceToolkit.NET.Views.Tools.UptimeToolView"
             x:DataType="vm:UptimeToolViewModel">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <daisy:DaisyInput Text="{Binding Url}" PlaceholderText="Enter URL" Width="400" />
            <daisy:DaisyButton Command="{Binding CheckCommand}" Content="Check" Variant="Primary" HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="16" />

        <Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto, Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status Code: " Margin="0,0,10,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusCode}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Response Time: " Margin="0,0,10,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResponseTime, StringFormat='{}{0} ms'}"/>
        </Grid>
    </StackPanel>
</UserControl>
