<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="35"
             x:Class="OpenSourceToolkit.NET.Controls.NumericEntry"
             x:Name="Root">
    <daisy:DaisyInput x:Name="Input"
                      Size="Small"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="{Binding Watermark, ElementName=Root}"
                      MaxLength="{Binding MaxLength, ElementName=Root}"
                      Foreground="{DynamicResource DaisyBaseContentBrush}" />
</UserControl>
