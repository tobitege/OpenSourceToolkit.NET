<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="35"
             x:Class="OpenSourceToolkit.NET.Controls.CopyableInput"
             x:Name="Root"
             MinWidth="120">
    <Grid ColumnDefinitions="*,Auto">
        <daisy:DaisyInput Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                 PlaceholderText="{Binding Watermark, ElementName=Root}"
                 IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Stretch" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="2,0,0,0" VerticalAlignment="Center">
            <daisy:DaisyButton Click="Copy_Click" ToolTip.Tip="Copy to Clipboard" Size="ExtraSmall" Shape="Square" Variant="Ghost" Padding="0">
                <PathIcon Data="{DynamicResource CopyIcon}" Width="10" Height="10"/>
            </daisy:DaisyButton>
            <daisy:DaisyButton Click="Clear_Click" ToolTip.Tip="Clear" Size="ExtraSmall" Shape="Square" Variant="Ghost" Padding="0">
                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="10" Height="10"/>
            </daisy:DaisyButton>
        </StackPanel>
    </Grid>
</UserControl>
