<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath Condition="'$(Configuration)'=='Debug'">..\bin\debug\</OutputPath>
    <OutputPath Condition="'$(Configuration)'=='Release'">..\bin\release\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>OpenSourceToolkit.NET</RootNamespace>
    <AssemblyName>OpenSourceToolkit.NET</AssemblyName>
    <StartupObject>OpenSourceToolkit.NET.EntryPoint</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- JSON-based localization for WASM compatibility (runtime switching) -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="Localization\de.json" />
    <EmbeddedResource Include="Localization\fr.json" />
    <EmbeddedResource Include="Localization\es.json" />
    <EmbeddedResource Include="Localization\it.json" />
    <EmbeddedResource Include="Localization\ja.json" />
    <EmbeddedResource Include="Localization\ko.json" />
    <EmbeddedResource Include="Localization\he.json" />
    <EmbeddedResource Include="Localization\ar.json" />
    <EmbeddedResource Include="Localization\tr.json" />
    <EmbeddedResource Include="Localization\uk.json" />
    <EmbeddedResource Include="Localization\zh-Hans.json" />
  </ItemGroup>

  <!-- RESX files kept for backward compatibility and tooling support -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\ToolkitStrings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ToolkitStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\ToolkitStrings.de.resx">
      <DependentUpon>ToolkitStrings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />

    <!-- Flowery.NET: Conditional reference (local project vs NuGet) -->
  </ItemGroup>

  <!-- Use local Flowery.NET project reference when UseLocalFlowery is true -->
  <ItemGroup Condition="'$(UseLocalFlowery)' == 'true'">
    <ProjectReference Include="$(FloweryPath)\Flowery.NET.csproj" />
  </ItemGroup>

  <!-- Use NuGet package when UseLocalFlowery is false or not set -->
  <ItemGroup Condition="'$(UseLocalFlowery)' != 'true'">
    <PackageReference Include="Flowery.NET" Version="2.0.8" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageReference Include="NCrontab" Version="3.4.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.37.3" />
    <PackageReference Include="LlmTornado" Version="3.8.60" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSourceToolkit.Core\OpenSourceToolkit.Core.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.ApiTesting\OpenSourceToolkit.ApiTesting.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.TextData\OpenSourceToolkit.TextData.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Converters\OpenSourceToolkit.Converters.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Security\OpenSourceToolkit.Security.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Networking\OpenSourceToolkit.Networking.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Scheduling\OpenSourceToolkit.Scheduling.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.IO\OpenSourceToolkit.IO.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Documents\OpenSourceToolkit.Documents.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Media\OpenSourceToolkit.Media.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Colors\OpenSourceToolkit.Colors.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Hardware\OpenSourceToolkit.Hardware.csproj" />
    <ProjectReference Include="..\OpenSourceToolkit.Calculators\OpenSourceToolkit.Calculators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="**\*.axaml" />
    <AvaloniaXaml Include="**\*.axaml" />
  </ItemGroup>
</Project>
